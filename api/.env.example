PORT=8080
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...        # ASLA mobil uygulamaya konmaz
STORAGE_BUCKET=raw-chunks
MAX_CHUNK_BYTES=5242880              # 5 MB
RATE_LIMIT_PER_MIN=600               # anahtar başına
LOG_LEVEL=info
# Yalnızca yerel geliştirme: Supabase olmadan bellek içi depo (yeniden başlatınca silinir).
# DATA_BACKEND=memory
# DEV_API_KEYS=app:dev-app-key,admin:dev-admin-key
