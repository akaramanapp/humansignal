<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ResearchApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Research">

        <!-- §4.1: Ayarlar (ilk açılış) → Rıza → Oturum Kurulumu → Görevler → Özet -->
        <activity android:name=".LauncherActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ConsentActivity" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- Görevler tek tam ekran Activity'de; yön kilitli (oturumlar karşılaştırılabilir olsun). -->
        <activity android:name=".TaskActivity" android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SummaryActivity" android:exported="false" />

        <!-- Geliştirici ekranları -->
        <activity android:name=".LiveSensorActivity" android:exported="false" />
        <activity android:name=".ClockTestActivity" android:exported="false" />
        <activity android:name=".InputTestActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
